// Design tokens: a quiet, dark, neutral palette (the photo is the interface) with one cool accent; semantic colours
// only for the tools. The values are the sRGB conversion of OKLCH tokens, tinted toward the cool hue 255.
export global Theme {
    out property <color> bg: #0e1114;
    out property <color> canvas: #090b0e;
    out property <color> surface-1: #171a1e;
    out property <color> surface-2: #202328;
    out property <color> surface-3: #2a2e33;
    out property <color> line: #33373c;
    out property <color> line-strong: #494d54;
    out property <color> text: #eceff2;
    out property <color> text-2: #aeb1b6;
    out property <color> text-3: #92959a;
    out property <color> accent: #6fb8f5;
    out property <color> accent-strong: #499fe3;
    out property <color> accent-ink: #0a131a;
    out property <color> accent-soft: #1b354b;
    out property <color> keep: #4fce74;
    out property <color> remove: #f75d59;
    out property <color> hair: #e9c944;
    out property <color> warn: #ebbd57;
    out property <color> danger: #f66d67;

    out property <length> r-sm: 4px;
    out property <length> r-md: 6px;
    out property <length> fs-xs: 11px;
    out property <length> fs-sm: 12px;
    out property <length> fs-md: 13px;
    out property <length> fs-lg: 15px;
}

